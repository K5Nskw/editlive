# ---- 必須 ----------------------------------------------------------------
# 管理画面のログインパスワード。未設定だと起動ごとにランダム生成されログに出ます。
APP_PASSWORD=change-me

# ---- Railway が自動で入れる値（手動設定は不要）----------------------------
# PORT                      HTTP の待ち受けポート
# RAILWAY_PUBLIC_DOMAIN     公開ドメイン。PUBLIC_URL 未設定時はここから組み立てます
# RAILWAY_VOLUME_MOUNT_PATH ボリュームを付けると入る値。DATA_DIR 未設定なら
#                           これが録画の保存先になります
# RAILWAY_TCP_PROXY_DOMAIN / RAILWAY_TCP_PROXY_PORT
#                           TCP Proxy を有効にすると入る値。OBS に見せる RTMP の
#                           ホスト / ポートとして使われます。未設定のあいだは
#                           画面に「まだ外部から RTMP を受けられません」と出ます
# RAILWAY_TCP_APPLICATION_PORT
#                           TCP Proxy の転送先コンテナポート。RTMP の待ち受けは
#                           この値に自動で追従します（RTMP_PORT が優先）

# ---- 任意 ----------------------------------------------------------------
# 公開 URL を明示する場合（OAuth のリダイレクト先と共有リンクに使われます）
# PUBLIC_URL=https://editlive.up.railway.app

# 録画の保存先。Railway ではボリュームのマウント先が自動で使われるので、
# 別の場所に置きたいときだけ設定します
# DATA_DIR=/data

# RTMP の待ち受けポート（コンテナ内部）。Railway では TCP Proxy の転送先に
# 自動で合わせるので、通常は設定不要です
# RTMP_PORT=1935
# RTMP のアプリ名。rtmp://host:port/<RTMP_APP> になります
RTMP_APP=live

# OBS に案内する RTMP の接続先を手動で上書きしたい場合
# RTMP_PUBLIC_HOST=containers-us-west-1.railway.app
# RTMP_PUBLIC_PORT=12345

# 1 本あたりの最大録画時間（時間）
MAX_RECORDING_HOURS=6
# 同時に走らせる ffmpeg ジョブ数。メモリの小さいプランでは 1 のまま
JOB_CONCURRENCY=1
# タイムライン用サムネイルの間隔（秒）
THUMB_INTERVAL_SECONDS=10

# YouTube 連携（Google Cloud Console の OAuth クライアント）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Buffer 連携（画面からも登録できます）
# BUFFER_ACCESS_TOKEN=

# ログイン Cookie の署名鍵。未設定なら DATA_DIR に生成して再利用します
# SESSION_SECRET=

# LOG_LEVEL=info
